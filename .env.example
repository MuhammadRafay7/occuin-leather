DATABASE_URL=postgres://orsel:orsel@localhost:55434/orsel
APP_URL=http://localhost:3000

# Stripe keys. Required in production: without them, card checkout is unavailable. Use live keys in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Lets checkout complete without Stripe for local evaluation. Ignored when NODE_ENV=production.
ALLOW_DEMO_PAYMENTS=true

# Resend API key for transactional email. Required in production: without it, no email is sent and message text, including reset links, prints to the server log.
RESEND_API_KEY=
MAIL_FROM=Occuin <orders@example.com>

# WhatsApp number in international format. Without it, the WhatsApp buttons are hidden.
WHATSAPP_NUMBER=

# WhatsApp Business API, for automated messages only. Without both, sendWhatsApp logs and sends nothing.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# Signs order and shared quote links, at least 32 characters. Generate with: openssl rand -base64 48
# Required in production. Without it, links are signed with a key derived from DATABASE_URL and an error is logged.
LINK_SIGNING_SECRET=

# Administrator created by `npm run db:seed`. The password must be at least 12 characters.
ADMIN_EMAIL=admin@orsel.local
ADMIN_PASSWORD=
