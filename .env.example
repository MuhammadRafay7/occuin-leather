DATABASE_URL=postgres://orsel:orsel@localhost:55434/orsel
APP_URL=http://localhost:3000

# Stripe test or live keys. Without them, card checkout is unavailable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Lets checkout complete without Stripe for local evaluation. Ignored when NODE_ENV=production.
ALLOW_DEMO_PAYMENTS=true

# Resend API key for transactional email. Without it, emails print to the server log outside production.
RESEND_API_KEY=
MAIL_FROM=Occuin <orders@example.com>

# Administrator created by `npm run db:seed`. The password must be at least 12 characters.
ADMIN_EMAIL=admin@orsel.local
ADMIN_PASSWORD=
